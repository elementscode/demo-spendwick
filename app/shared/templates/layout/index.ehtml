import "./style.css";
import { redirect } from "@elements/app";
import { CurrentUser, roleLabel } from "#app/shared/models";
import { signout } from "#app/shared/services/auth";

function onSignout() {
  signout();
  redirect("/signin");
}

<Logo>
  <span class="brand-mark" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M8 1.5c1.8 2.2 3.5 4.1 3.5 6.6A3.5 3.5 0 0 1 4.5 8.1C4.5 5.6 6.2 3.7 8 1.5Z" fill="currentColor"/>
      <path d="M8 9v5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  </span>
  spendwick
</Logo>

<Layout (
  user: CurrentUser,
  active: string,
)>
  <div class="app">
    <header class="topbar">
      <div class="page-shell is-wide row topbar-inner">
        <a href="/requests" class="brand row"><Logo /></a>

        <nav class="topnav cluster is-xs" aria-label="Main">
          <a href="/requests" class={[active === "requests" && "is-active"]}>Requests</a>
          <a href="/requests/new" class={[active === "new" && "is-active"]}>New request</a>
          <a e:if={user.role === "finance"} href="/finance" class={[active === "finance" && "is-active"]}>Finance</a>
          <a e:if={user.role === "finance"} href="/departments" class={[active === "departments" && "is-active"]}>Departments</a>
        </nav>

        <div class="whoami row">
          <span class="whoami-name">
            <span>{user.name}</span>
            <span class="whoami-role">{roleLabel(user.role)}{user.departmentName ? ` · ${user.departmentName}` : ""}</span>
          </span>
          <button class="is-ghost is-sm" onclick={() => onSignout()}>Sign out</button>
        </div>
      </div>
    </header>

    <main class="app-main">
      <div class="page-shell is-wide app-content">
        <slot/>
      </div>
    </main>
  </div>
</Layout>
