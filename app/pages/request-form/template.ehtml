import "./style.css";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { InputGroup, InputGroupAddon, InputGroupText } from "@elements/ui/input-group";
import { NativeSelect } from "@elements/ui/native-select";
import { Textarea } from "@elements/ui/textarea";
import type { Listener } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import {
  Budget,
  CATEGORIES,
  CurrentUser,
  Department,
  FINANCE_THRESHOLD_CENTS,
  RequestForm,
  money,
  parseAmount,
} from "#app/shared/models";
import { fetchBudgets } from "#app/shared/services/departments";
import { RequestChange, saveRequest } from "#app/shared/services/requests";
import { Layout } from "#app/shared/templates/layout";
import { BudgetBar } from "#app/shared/templates/request-ui";

interface View {
  form: RequestForm;
  budgets: Budget[];
  errors: Record<string, string[]>;
  error: string;
  busy: "" | "draft" | "submit";
}

interface RouteStep {
  id: string;
  n: number;
  title: string;
  who: string;
}

function onChange(view: View) {
  view.budgets = fetchBudgets();
}

function onSave(view: View, submit: boolean) {
  view.busy = submit ? "submit" : "draft";
  view.error = "";

  try {
    saveRequest(view.form, submit);
  } catch (err: any) {
    view.errors = err.errors ?? {};
    view.error = err.errors ? "Fix the highlighted fields." : err.message;
    view.busy = "";
  }
}

function fieldError(errors: Record<string, string[]>, name: string): string {
  return errors[name]?.[0] ?? "";
}

function cents(view: View): number {
  let n = parseAmount(view.form.amount);

  return Number.isFinite(n) ? n : 0;
}

function route(user: CurrentUser, departments: Department[], view: View): RouteStep[] {
  let dept = departments.find((d) => d.id === view.form.departmentId);
  if (!dept) {
    return [];
  }

  let skipHead = !dept.headId || dept.headId === user.id;
  let steps: RouteStep[] = [];

  if (!skipHead) {
    steps.push({
      id: "head",
      n: 1,
      title: "Department head",
      who: `${dept.headName}, ${dept.name}`,
    });
  }

  if (skipHead || cents(view) > FINANCE_THRESHOLD_CENTS) {
    steps.push({
      id: "finance",
      n: steps.length + 1,
      title: "Finance",
      who: skipHead ? "Because you head this department" : "Because it is over $1,000",
    });
  }

  return steps;
}

<html lang="en" class="page-request-form" (
  user: CurrentUser,
  changes: Listener<RequestChange>,
  departments: Department[],
  initialBudgets: Budget[],
  initial: RequestForm,
  private view: View = {
    form: initial,
    budgets: initialBudgets,
    errors: {},
    error: "",
    busy: "",
  },
) oninit={() => changes.on("notify", () => onChange(view))}>
  <head>
    <title>{initial.id ? "Edit draft" : "New request"} · Spendwick</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {user} active={initial.id ? "requests" : "new"}>
      <form class="stack is-xl" onsubmit={() => onSave(view, true)}>
        <div class="form-head stack is-xs">
          <a e:if={initial.id} class="back text-sm" href={`/requests/${initial.id}`}>← Back to the request</a>
          <h1>{initial.id ? "Edit draft" : "New purchase request"}</h1>
          <p>Save a draft to finish later, or submit it to start the approvals.</p>
        </div>

        <div class="form-grid">
          <Card>
            <CardContent class="stack is-sm">
              <Alert e:if={view.error} variant="danger">{view.error}</Alert>

              <Field label="What are you buying?" error={fieldError(view.errors, "item")} required>
                <Input value={view.form.item} placeholder="Ergonomic chairs (x6)" />
              </Field>

              <div class="form-pair">
                <Field label="Vendor" error={fieldError(view.errors, "vendor")} required>
                  <Input value={view.form.vendor} placeholder="Fernhill Furniture" />
                </Field>

                <Field label="Amount (USD)" error={fieldError(view.errors, "amount")} required>
                  <InputGroup class="amount-input">
                    <Input value={view.form.amount} placeholder="1,250.00" attrs={{ inputmode: "decimal" }} />
                    <InputGroupAddon><InputGroupText>$</InputGroupText></InputGroupAddon>
                  </InputGroup>
                </Field>

                <Field label="Department" error={fieldError(view.errors, "departmentId")} required>
                  <NativeSelect value={view.form.departmentId}
                                placeholder="Pick a department"
                                options={departments.map((d) => ({ value: d.id, label: d.name }))}
                                required
                                block />
                </Field>

                <Field label="Category" error={fieldError(view.errors, "category")} required>
                  <NativeSelect value={view.form.category}
                                placeholder="Pick a category"
                                options={CATEGORIES.map((c) => ({ value: c, label: c }))}
                                required
                                block />
                </Field>
              </div>

              <Field label="Why do you need it?">
                <Textarea value={view.form.reason} placeholder="What it is for, and what happens if we do not buy it" />
              </Field>

              <div class="field">
                <label for="quote">Quote</label>
                <input id="quote" type="file" accept=".pdf,.png,.jpg,.jpeg,.webp,.txt" value={view.form.quote} class={[view.errors.quote && "is-error"]}>
                <p e:if={view.form.quoteName && !view.form.quote} class="hint">Attached: {view.form.quoteName}. Choose a file to replace it.</p>
                <p e:else class="hint">PDF, image or text, up to 10 MB.</p>
                <p e:if={view.errors.quote} class="error">{view.errors.quote[0]}</p>
              </div>
            </CardContent>
            <CardFooter>
              <Button variant="ghost" disabled={view.busy === "submit"} loading={view.busy === "draft"} onclick={() => onSave(view, false)}>Save draft</Button>
              <Button type="submit" variant="primary" disabled={view.busy === "draft"} loading={view.busy === "submit"}>Submit for approval</Button>
            </CardFooter>
          </Card>

          <div class="form-side stack is-lg">
            <Card title="Approval route" level={2}>
              <CardContent>
                <ol e:if={route(user, departments, view).length > 0} class="route-list">
                  <li e:for={s of route(user, departments, view)}>
                    <span class="route-num">{s.n}</span>
                    <span>
                      <strong>{s.title}</strong><br>
                      <span class="route-who">{s.who}</span>
                    </span>
                  </li>
                </ol>
                <p e:else class="hint">Pick a department to see who approves this.</p>
              </CardContent>
            </Card>

            <Card e:if={view.budgets.find((b) => b.departmentId === view.form.departmentId)}>
              <CardContent>
                <BudgetBar budget={view.budgets.find((b) => b.departmentId === view.form.departmentId)!}
                           amountCents={cents(view)}
                           status="draft" />
              </CardContent>
            </Card>
          </div>
        </div>
      </form>
    </Layout>
  </body>
</html>
