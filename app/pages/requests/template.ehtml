import "./style.css";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@elements/ui/card";
import { Empty, EmptyDescription } from "@elements/ui/empty";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@elements/ui/tabs";
import type { Listener } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { CurrentUser, RequestRow, STATUSES, Status, money, requestNumber, shortDate, statusLabel } from "#app/shared/models";
import { RequestChange, RequestsPage, fetchRequestsPage } from "#app/shared/services/requests";
import { Layout } from "#app/shared/templates/layout";
import { BudgetBar, StatusCell } from "#app/shared/templates/request-ui";

const TABS = [
  { id: "all", label: "All" },
  ...STATUSES.map((s) => ({
    id: s,
    label: statusLabel(s),
  })),
];

interface View {
  page: RequestsPage;
  filter: string;
}

function onChange(view: View) {
  view.page = fetchRequestsPage();
}

function visible(view: View): RequestRow[] {
  return view.filter === "all" ? view.page.rows : view.page.rows.filter((r) => r.status === view.filter);
}

function count(rows: RequestRow[], status: string): number {
  return status === "all" ? rows.length : rows.filter((r) => r.status === status).length;
}

function scopeLine(user: CurrentUser): string {
  if (user.role === "finance") {
    return "Every purchase request across the company.";
  }

  if (user.headOfId) {
    return `Your requests and everything submitted in ${user.departmentName}.`;
  }

  return "Requests you have made.";
}

<RequestsTable (
  user: CurrentUser,
  rows: RequestRow[],
  filter: string,
)>
  <Table e:if={rows.length > 0} label="Requests" class="requests-table">
    <table>
      <thead>
        <tr>
          <TableHead class="hide-sm">#</TableHead>
          <TableHead>Item</TableHead>
          <TableHead e:if={user.role !== "employee"} class="hide-sm">Requested by</TableHead>
          <TableHead class="hide-sm">Category</TableHead>
          <TableHead align="end">Amount</TableHead>
          <TableHead>Status</TableHead>
          <TableHead class="hide-sm">Submitted</TableHead>
        </tr>
      </thead>
      <tbody>
        <tr e:for={r of rows}>
          <TableCell class="num hide-sm">{requestNumber(r.number)}</TableCell>
          <TableCell class="item">
            <a href={`/requests/${r.id}`}>{r.item}</a>
            <span class="sub">{r.vendor} · {r.departmentName}</span>
          </TableCell>
          <TableCell e:if={user.role !== "employee"} class="hide-sm">{r.requesterName}</TableCell>
          <TableCell class="hide-sm">{r.category}</TableCell>
          <TableCell align="end" class="amount">{money(r.amountCents)}</TableCell>
          <TableCell><StatusCell state={r.status} pendingStep={r.pendingStep} /></TableCell>
          <TableCell class="hide-sm sub">{r.submittedAt ? shortDate(r.submittedAt) : "Not yet"}</TableCell>
        </tr>
      </tbody>
    </table>
  </Table>
  <Empty e:else>
    <EmptyDescription e:if={filter === "all"}>No requests yet. <a href="/requests/new">Start one</a>.</EmptyDescription>
    <EmptyDescription e:else>No {statusLabel(filter as Status).toLowerCase()} requests.</EmptyDescription>
  </Empty>
</RequestsTable>

<html lang="en" class="page-requests" (
  user: CurrentUser,
  changes: Listener<RequestChange>,
  initial: RequestsPage,
  private view: View = {
    page: initial,
    filter: "all",
  },
) oninit={() => changes.on("notify", () => onChange(view))}>
  <head>
    <title>Requests · Spendwick</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {user} active="requests">
      <div class="stack is-xl">
        <div class="page-head row">
          <div class="stack is-xs">
            <h1>Requests</h1>
            <p>{scopeLine(user)}</p>
          </div>
          <Button href="/requests/new" variant="primary">New request</Button>
        </div>

        <div e:if={user.role !== "employee"} class={["requests-top", !view.page.budget && "is-single"]}>
          <Card>
            <CardHeader>
              <CardTitle level={2}>Waiting on you<Badge variant="outline" class="count">{view.page.inbox.length}</Badge></CardTitle>
            </CardHeader>
            <ul e:if={view.page.inbox.length > 0} class="inbox">
              <li e:for={r of view.page.inbox}>
                <a href={`/requests/${r.id}`}>
                  <span class="inbox-item">{r.item}</span>
                  <span class="amount">{money(r.amountCents)}</span>
                  <span class="inbox-meta">{requestNumber(r.number)} · {r.requesterName} · {r.departmentName}</span>
                  <span class="inbox-meta">{r.pendingStep === "finance" ? "Finance approval" : "Head approval"}</span>
                </a>
              </li>
            </ul>
            <CardContent e:else>
              <Empty>
                <EmptyDescription>Nothing needs your approval right now.</EmptyDescription>
              </Empty>
            </CardContent>
          </Card>

          <Card e:if={view.page.budget}>
            <CardContent>
              <BudgetBar budget={view.page.budget!} />
            </CardContent>
          </Card>
        </div>

        <Card>
          <Tabs value={view.filter}>
            <TabsList label="Status">
              <TabsTrigger e:for={t of TABS} value={t.id}>
                {t.label}<span class="tab-count">{count(view.page.rows, t.id)}</span>
              </TabsTrigger>
            </TabsList>
            <TabsContent e:for={t of TABS} value={t.id}>
              <RequestsTable e:if={view.filter === t.id} {user} rows={visible(view)} filter={t.id} />
            </TabsContent>
          </Tabs>
        </Card>
      </div>
    </Layout>
  </body>
</html>
