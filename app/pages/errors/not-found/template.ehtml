import "./style.css";
import { Button } from "@elements/ui/button";

<html lang="en" class="page-errors-not-found">
  <body class="error-page center">
    <main class="error-panel stack">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found.</h1>
      <p>The page you're looking for doesn't exist or has moved.</p>
      <nav class="cluster error-actions">
        <Button href="/" variant="primary">Go home</Button>
        <Button href="javascript:history.back()" variant="ghost">Go back</Button>
      </nav>
    </main>
  </body>
</html>
