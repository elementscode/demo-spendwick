import "./style.css";
import type { Listener } from "@elements/app";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@elements/ui/card";
import type { ChartConfig } from "@elements/ui/chart";
import { BarChart } from "@elements/ui/chart-bar";
import { DataTable, DataTableColumn } from "@elements/ui/data-table";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import {
  CurrentUser,
  Department,
  RequestRow,
  STATUSES,
  SpendRow,
  money,
  quarterStart,
  requestNumber,
  shortDate,
  statusIntent,
  statusLabel,
} from "#app/shared/models";
import { FinancePage, fetchFinancePage } from "#app/shared/services/finance";
import { RequestChange } from "#app/shared/services/requests";
import { Layout } from "#app/shared/templates/layout";

interface Filters {
  status: string;
  department: string;
  range: "quarter" | "all";
  search: string;
}

interface View {
  page: FinancePage;
  filters: Filters;
  phone: boolean;
}

const STATUS_OPTIONS = STATUSES.filter((s) => s !== "draft").map((s) => ({
  value: s,
  label: statusLabel(s),
}));

const PERIOD_OPTIONS = [
  { value: "quarter", label: "This quarter" },
  { value: "all", label: "All time" },
];

const DEPARTMENT_CHART: ChartConfig = {
  committed: { label: "Committed", color: "var(--accent)" },
  pending: { label: "Pending", color: "color-mix(in oklab, var(--accent) 35%, var(--bg-muted))" },
  left: { label: "Unspent budget", color: "var(--bg-muted)" },
};

const CATEGORY_CHART: ChartConfig = {
  committed: { label: "Committed", color: "var(--accent)" },
  pending: { label: "Pending", color: "color-mix(in oklab, var(--accent) 35%, var(--bg-muted))" },
};

const COLUMNS: DataTableColumn[] = [
  {
    id: "number",
    header: "#",
    value: (row) => requestNumber((row as RequestRow).number),
    cell: (row) => ({ text: requestNumber((row as RequestRow).number), mono: true, muted: true }),
  },
  {
    id: "item",
    header: "Item",
    rowHeader: true,
    wrap: true,
    value: (row) => (row as RequestRow).item,
    cell: (row) => itemCell(row as RequestRow),
  },
  { key: "requesterName", header: "Requested by" },
  { key: "category", header: "Category" },
  {
    id: "amount",
    header: "Amount",
    align: "end",
    value: (row) => (row as RequestRow).amountCents,
    cell: (row) => money((row as RequestRow).amountCents),
  },
  {
    id: "status",
    header: "Status",
    value: (row) => statusLabel((row as RequestRow).status),
    cell: (row) => statusCell(row as RequestRow),
  },
  {
    id: "submitted",
    header: "Submitted",
    value: (row) => (row as RequestRow).submittedAt,
    cell: (row) => ({ text: submittedText(row as RequestRow), muted: true }),
  },
];

// The columns a phone leaves out, so the rest fit the screen.
const PHONE_HIDDEN = ["number", "requesterName", "category", "submitted"];

function itemCell(r: RequestRow) {
  return {
    text: r.item,
    href: `/requests/${r.id}`,
    description: `${r.vendor} · ${r.departmentName}`,
  };
}

function statusCell(r: RequestRow) {
  return {
    text: statusLabel(r.status),
    tone: statusIntent(r.status),
    description: r.status === "submitted" && r.pendingStep ? `waiting on ${r.pendingStep}` : undefined,
  };
}

function submittedText(r: RequestRow): string {
  return r.submittedAt ? shortDate(r.submittedAt) : "";
}

function watchPhone(view: View): () => void {
  let query = matchMedia("(max-width: 40rem)");
  let update = () => view.phone = query.matches;

  update();
  query.addEventListener("change", update);

  return () => query.removeEventListener("change", update);
}

function onChange(view: View) {
  view.page = fetchFinancePage();
}

function filtered(view: View): RequestRow[] {
  let f = view.filters;
  let start = quarterStart(new Date());
  let q = f.search.trim().toLowerCase();

  return view.page.rows.filter((r) =>
    r.status !== "draft"
    && (!f.status || r.status === f.status)
    && (!f.department || r.departmentId === f.department)
    && (f.range === "all" || (r.submittedAt && r.submittedAt >= start))
    && (!q || `${r.item} ${r.vendor} ${r.requesterName} ${requestNumber(r.number)}`.toLowerCase().includes(q)));
}

function exportUrl(f: Filters): string {
  let p = new URLSearchParams({
    status: f.status,
    department: f.department,
    range: f.range,
  });

  return `/finance/export.csv?${p}`;
}

interface DepartmentBar {
  label: string;
  committed: number;
  pending: number;
  left: number;
  budget: number;
}

function departmentBars(rows: SpendRow[]): DepartmentBar[] {
  return rows.map((r) => ({
    label: r.label,
    committed: r.committedCents,
    pending: r.pendingCents,
    left: Math.max(0, r.budgetCents - r.committedCents - r.pendingCents),
    budget: r.budgetCents,
  }));
}

function categoryBars(rows: SpendRow[]) {
  return rows.map((r) => ({
    label: r.label,
    committed: r.committedCents,
    pending: r.pendingCents,
  }));
}

function budgetNote(row: DepartmentBar): string {
  let { budget, committed } = row;

  return committed > budget ? `${money(committed - budget)} over its ${money(budget)} budget` : `of ${money(budget)} · ${money(budget - committed)} left`;
}

<html lang="en" class="page-finance" (
  user: CurrentUser,
  changes: Listener<RequestChange>,
  departments: Department[],
  initial: FinancePage,
  private view: View = {
    page: initial,
    filters: {
      status: "",
      department: "",
      range: "quarter",
      search: "",
    },
    phone: false,
  },
  private release: () => void = () => {},
) oninit={() => changes.on("notify", () => onChange(view))}>
  <head>
    <title>Finance · Spendwick</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {user} active="finance">
      <div class="stack is-xl">
        <div class="page-head row">
          <div class="stack is-xs">
            <h1>Finance</h1>
            <p>Spend across every department for {view.page.summary.quarter}. Updates as requests are decided.</p>
          </div>
          <Button href={exportUrl(view.filters)} attrs={{ download: true }}>Export CSV</Button>
        </div>

        <div class="tiles">
          <Card class="tile">
            <span class="tile-label">Quarterly budget</span>
            <span class="tile-value">{money(view.page.summary.totalBudgetCents)}</span>
            <span class="tile-note">{view.page.summary.byDepartment.length} departments</span>
          </Card>
          <Card class="tile">
            <span class="tile-label">Committed</span>
            <span class="tile-value">{money(view.page.summary.totalCommittedCents)}</span>
            <span class="tile-note">Approved, ordered and received</span>
          </Card>
          <Card class="tile">
            <span class="tile-label">Remaining</span>
            <span class="tile-value">{money(view.page.summary.totalBudgetCents - view.page.summary.totalCommittedCents)}</span>
            <span class="tile-note">{money(view.page.summary.totalPendingCents)} more is pending</span>
          </Card>
          <Card class="tile">
            <span class="tile-label">Waiting on finance</span>
            <span class="tile-value">{view.page.summary.awaitingFinance}</span>
            <a e:if={view.page.summary.awaitingFinance > 0} href="/requests">Review them</a>
            <span e:else class="tile-note">All caught up</span>
          </Card>
        </div>

        <div class="charts">
          <Card title="Spend by department" level={2}>
            <CardContent>
              <BarChart data={departmentBars(view.page.summary.byDepartment)}
                        config={DEPARTMENT_CHART}
                        x="label"
                        orientation="horizontal"
                        stack="normal"
                        legend
                        maxBarSize={28}
                        label="Spend by department"
                        categoryAxis={{ size: 96 }}
                        tooltip={{ formatter: (value) => money(value as number), footer: (row) => budgetNote(row as DepartmentBar) }}
                        class="spend-chart is-departments" />
            </CardContent>
          </Card>

          <Card title="Spend by category" level={2}>
            <CardContent>
              <BarChart e:if={view.page.summary.byCategory.length > 0}
                        data={categoryBars(view.page.summary.byCategory)}
                        config={CATEGORY_CHART}
                        x="label"
                        orientation="horizontal"
                        stack="normal"
                        legend
                        maxBarSize={28}
                        label="Spend by category"
                        categoryAxis={{ size: 120 }}
                        tooltip={{ formatter: (value) => money(value as number) }}
                        class="spend-chart is-categories" />
              <p e:else class="hint">No spend this quarter yet.</p>
            </CardContent>
          </Card>
        </div>

        <Card>
          <CardHeader>
            <CardTitle level={2}>All requests</CardTitle>
          </CardHeader>

          <div class="filters cluster">
            <Input type="search" class="grow" value={view.filters.search} placeholder="Search item, vendor, person" attrs={{ "aria-label": "Search" }} />
            <NativeSelect value={view.filters.status} options={[{ value: "", label: "Any status" }, ...STATUS_OPTIONS]} attrs={{ "aria-label": "Status" }} />
            <NativeSelect value={view.filters.department} class="is-department" options={[{ value: "", label: "All departments" }, ...departments.map((d) => ({ value: d.id, label: d.name }))]} attrs={{ "aria-label": "Department" }} />
            <NativeSelect value={view.filters.range} options={PERIOD_OPTIONS} attrs={{ "aria-label": "Period" }} />
          </div>

          <DataTable data={filtered(view)}
                     columns={COLUMNS}
                     label="All requests"
                     rowId={(row) => (row as RequestRow).id}
                     hidden={view.phone ? PHONE_HIDDEN : []}
                     emptyText="No requests match these filters."
                     toolbar={false}
                     footer={false}
                     pagination={false}
                     sortable={false}
                     columnMenu={false}
                     resizable={false}
                     reorderable={false}
                     oninsert={() => release = watchPhone(view)}
                     onremove={() => release()} />

          <div class="table-foot row">
            <span>{filtered(view).length} requests</span>
            <span>{money(filtered(view).reduce((n, r) => n + r.amountCents, 0))} total</span>
          </div>
        </Card>
      </div>
    </Layout>
  </body>
</html>
