import "./style.css";
import type { Listener } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Budget, CurrentUser, Department } from "#app/shared/models";
import { DepartmentForm, Person, fetchBudgets, saveDepartment } from "#app/shared/services/departments";
import { RequestChange } from "#app/shared/services/requests";
import { Layout } from "#app/shared/templates/layout";
import { BudgetBar } from "#app/shared/templates/request-ui";

interface Editor {
  id: string;
  form: DepartmentForm;
  errors: Record<string, string[]>;
  saved: boolean;
  busy: boolean;
}

interface View {
  editors: Editor[];
  budgets: Budget[];
  adding: Editor;
}

function editorFor(d: Department): Editor {
  return {
    id: d.id,
    form: {
      id: d.id,
      name: d.name,
      budget: String(d.quarterlyBudgetCents / 100),
      headId: d.headId ?? "",
    },
    errors: {},
    saved: false,
    busy: false,
  };
}

function blank(): Editor {
  return {
    id: "new",
    form: {
      id: "",
      name: "",
      budget: "",
      headId: "",
    },
    errors: {},
    saved: false,
    busy: false,
  };
}

function onChange(view: View) {
  view.budgets = fetchBudgets();
}

function onSave(view: View, editor: Editor) {
  editor.busy = true;
  editor.saved = false;

  try {
    let departments = saveDepartment(editor.form);
    editor.errors = {};

    if (editor.id === "new") {
      view.adding = blank();
    }

    view.editors = departments.map(editorFor);
    view.editors.find((e) => e.id === (editor.id === "new" ? departments.find((d) => d.name === editor.form.name.trim())?.id : editor.id))!.saved = true;
    view.budgets = fetchBudgets();
  } catch (err: any) {
    editor.errors = err.errors ?? { name: [err.message] };
  }

  editor.busy = false;
}

<DeptFields (
  editor: Editor,
  people: Person[],
)>
  <div class="dept-fields">
    <div class="field">
      <label for={`name-${editor.id}`}>Name</label>
      <input id={`name-${editor.id}`} value={editor.form.name} class={[editor.errors.name && "is-error"]} required>
      <p e:if={editor.errors.name} class="error">{editor.errors.name[0]}</p>
    </div>

    <div class="field">
      <label for={`budget-${editor.id}`}>Quarterly budget ($)</label>
      <input id={`budget-${editor.id}`} inputmode="decimal" value={editor.form.budget} class={[editor.errors.budget && "is-error"]} required>
      <p e:if={editor.errors.budget} class="error">{editor.errors.budget[0]}</p>
    </div>

    <div class="field is-full">
      <label for={`head-${editor.id}`}>Department head</label>
      <select id={`head-${editor.id}`} value={editor.form.headId}>
        <option value="">No head (finance approves everything)</option>
        <option e:for={p of people} value={p.id}>{p.name}</option>
      </select>
    </div>
  </div>
</DeptFields>

<html lang="en" class="page-departments" (
  user: CurrentUser,
  changes: Listener<RequestChange>,
  people: Person[],
  initial: Department[],
  initialBudgets: Budget[],
  private view: View = {
    editors: initial.map(editorFor),
    budgets: initialBudgets,
    adding: blank(),
  },
) oninit={() => changes.on("notify", () => onChange(view))}>
  <head>
    <title>Departments · Spendwick</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {user} active="departments">
      <div class="stack is-xl">
        <div class="page-head stack is-xs">
          <h1>Departments</h1>
          <p>Each head approves their department's requests. Budgets reset every quarter.</p>
        </div>

        <div class="dept-list">
          <form e:for={e of view.editors} class="card" onsubmit={() => onSave(view, e)}>
            <div class="card-body dept-form">
              <DeptFields editor={e} {people} />
              <BudgetBar e:if={view.budgets.find((b) => b.departmentId === e.id)}
                         budget={view.budgets.find((b) => b.departmentId === e.id)!}
                         title="This quarter" />
            </div>
            <div class="card-foot">
              <span e:if={e.saved} class="dept-saved" role="status">Saved</span>
              <button type="submit" class="is-primary" disabled={e.busy}>Save</button>
            </div>
          </form>

          <form class="card" onsubmit={() => onSave(view, view.adding)}>
            <div class="card-head">
              <h2>Add a department</h2>
            </div>
            <div class="card-body">
              <DeptFields editor={view.adding} {people} />
            </div>
            <div class="card-foot">
              <button type="submit" class="is-primary" disabled={view.adding.busy}>Add department</button>
            </div>
          </form>
        </div>
      </div>
    </Layout>
  </body>
</html>
