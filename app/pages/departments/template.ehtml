import "./style.css";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import { toast } from "@elements/ui/toast";
import type { Listener } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Budget, CurrentUser, Department } from "#app/shared/models";
import { DepartmentForm, Person, fetchBudgets, saveDepartment } from "#app/shared/services/departments";
import { RequestChange } from "#app/shared/services/requests";
import { Layout } from "#app/shared/templates/layout";
import { BudgetBar } from "#app/shared/templates/request-ui";

interface Editor {
  id: string;
  form: DepartmentForm;
  errors: Record<string, string[]>;
  busy: boolean;
}

interface View {
  editors: Editor[];
  budgets: Budget[];
  adding: Editor;
}

function editorFor(d: Department): Editor {
  return {
    id: d.id,
    form: {
      id: d.id,
      name: d.name,
      budget: String(d.quarterlyBudgetCents / 100),
      headId: d.headId ?? "",
    },
    errors: {},
    busy: false,
  };
}

function blank(): Editor {
  return {
    id: "new",
    form: {
      id: "",
      name: "",
      budget: "",
      headId: "",
    },
    errors: {},
    busy: false,
  };
}

function onChange(view: View) {
  view.budgets = fetchBudgets();
}

function onSave(view: View, editor: Editor) {
  editor.busy = true;

  try {
    let departments = saveDepartment(editor.form);
    editor.errors = {};

    if (editor.id === "new") {
      view.adding = blank();
    }

    view.editors = departments.map(editorFor);
    view.budgets = fetchBudgets();
    toast.success("Saved", { description: editor.form.name.trim() });
  } catch (err: any) {
    editor.errors = err.errors ?? { name: [err.message] };
  }

  editor.busy = false;
}

<DeptFields (
  editor: Editor,
  people: Person[],
)>
  <div class="dept-fields">
    <Field label="Name" error={editor.errors.name?.[0] ?? ""} required>
      <Input value={editor.form.name} />
    </Field>

    <Field label="Quarterly budget ($)" error={editor.errors.budget?.[0] ?? ""} required>
      <Input value={editor.form.budget} attrs={{ inputmode: "decimal" }} />
    </Field>

    <Field label="Department head" class="is-full">
      <NativeSelect value={editor.form.headId}
                    options={[{ value: "", label: "No head (finance approves everything)" }, ...people.map((p) => ({ value: p.id, label: p.name }))]}
                    block />
    </Field>
  </div>
</DeptFields>

<html lang="en" class="page-departments" (
  user: CurrentUser,
  changes: Listener<RequestChange>,
  people: Person[],
  initial: Department[],
  initialBudgets: Budget[],
  private view: View = {
    editors: initial.map(editorFor),
    budgets: initialBudgets,
    adding: blank(),
  },
) oninit={() => changes.on("notify", () => onChange(view))}>
  <head>
    <title>Departments · Spendwick</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {user} active="departments">
      <div class="stack is-xl">
        <div class="page-head stack is-xs">
          <h1>Departments</h1>
          <p>Each head approves their department's requests. Budgets reset every quarter.</p>
        </div>

        <div class="dept-list">
          <form e:for={e of view.editors} onsubmit={() => onSave(view, e)}>
            <Card>
              <CardContent class="dept-form">
                <DeptFields editor={e} {people} />
                <BudgetBar e:if={view.budgets.find((b) => b.departmentId === e.id)}
                           budget={view.budgets.find((b) => b.departmentId === e.id)!}
                           title="This quarter" />
              </CardContent>
              <CardFooter>
                <Button type="submit" variant="primary" loading={e.busy}>Save</Button>
              </CardFooter>
            </Card>
          </form>

          <form onsubmit={() => onSave(view, view.adding)}>
            <Card title="Add a department" level={2}>
              <CardContent>
                <DeptFields editor={view.adding} {people} />
              </CardContent>
              <CardFooter>
                <Button type="submit" variant="primary" loading={view.adding.busy}>Add department</Button>
              </CardFooter>
            </Card>
          </form>
        </div>
      </div>
    </Layout>
  </body>
</html>
